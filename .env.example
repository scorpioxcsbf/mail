# Domains MEHDI MAIL accepts mail for (comma-separated)
DOMAINS=mail.example.com

# Web UI port
HTTP_PORT=3000

# --- Mode A: Built-in SMTP (requires a real VPS with port 25 open) ---
SMTP_ENABLED=true
SMTP_PORT=25
SMTP_HOST=0.0.0.0

# --- Mode B: Mailgun Inbound Webhook (use on Wispbyte / PaaS hosts) ---
# SMTP_ENABLED=false
# MAILGUN_WEBHOOK_SIGNING_KEY=your-signing-key-here

# SQLite database path
DB_PATH=./data/mehdi-mail.db

# Inbox settings
DEFAULT_TTL_MINUTES=60
MAX_TTL_MINUTES=1440
MAX_ADDRESSES_PER_IP_PER_HOUR=20
MAX_MESSAGE_BYTES=5242880
MAX_MESSAGES_PER_INBOX=200

TRUST_PROXY=true
